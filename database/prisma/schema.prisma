// QuickStore relational model.
// Conventions:
//  - UUID primary keys, snake_case tables/columns, timestamps in UTC (timestamptz).
//  - Every tenant-scoped row carries organization_id.
//  - Currency is Decimal(14,2); quantities are integers in the SKU's base unit.
//  - inventory_movements is append-only (enforced by a trigger in migration 0002).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY & ACCESS
// ============================================================================

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum ScopeType {
  ORGANIZATION
  REGION
  WAREHOUSE
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String?    @map("organization_id") @db.Uuid
  email             String?    @unique
  phone             String?    @unique
  fullName          String     @map("full_name")
  passwordHash      String     @map("password_hash")
  status            UserStatus @default(ACTIVE)
  isSuperAdmin      Boolean    @default(false) @map("is_super_admin")
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  mfaSecret         String?    @map("mfa_secret")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(3)

  organization  Organization?        @relation(fields: [organizationId], references: [id])
  roles         UserRole[]
  sessions      UserSession[]
  resetTokens   PasswordResetToken[]
  scopes        UserScope[]
  deliveryPartner DeliveryPartner?

  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization?    @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  module      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Resource-level scope: restricts a user to a region or specific warehouses/stores.
/// A user with no scope rows has organization-wide access (subject to permissions).
model UserScope {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  scopeType ScopeType @map("scope_type")
  scopeId   String    @map("scope_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeId])
  @@map("user_scopes")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("user_sessions")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  userId     String?  @map("user_id") @db.Uuid
  success    Boolean
  reason     String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ============================================================================
// ORGANIZATION
// ============================================================================

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  gstin     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  businessUnits BusinessUnit[]
  regions       Region[]
  warehouses    Warehouse[]
  users         User[]
  roles         Role[]

  @@map("organizations")
}

model BusinessUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("business_units")
}

model Region {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  warehouses   Warehouse[]

  @@unique([organizationId, code])
  @@map("regions")
}

enum WarehouseType {
  CENTRAL_WAREHOUSE
  DISTRIBUTION_CENTER
  DARK_STORE
}

enum SiteStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  CLOSED
}

/// Every stock-holding site (central warehouse, DC or dark store) is a row here so
/// that inventory, transfers and movements reference one location type.
/// Dark-store specific attributes live in dark_stores (1:1).
model Warehouse {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  regionId       String?       @map("region_id") @db.Uuid
  code           String
  name           String
  type           WarehouseType
  status         SiteStatus    @default(ACTIVE)
  addressLine1   String        @map("address_line1")
  addressLine2   String?       @map("address_line2")
  city           String
  state          String
  postalCode     String        @map("postal_code")
  country        String        @default("IN")
  latitude       Decimal?      @db.Decimal(9, 6)
  longitude      Decimal?      @db.Decimal(9, 6)
  capacityUnits  Int?          @map("capacity_units")
  managerId      String?       @map("manager_id") @db.Uuid
  operatingHours Json?         @map("operating_hours")
  temperatureZones String[]    @default([]) @map("temperature_zones")
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  organization     Organization       @relation(fields: [organizationId], references: [id])
  region           Region?            @relation(fields: [regionId], references: [id])
  darkStore        DarkStore?
  locations        StorageLocation[]
  balances         InventoryBalance[]
  batches          InventoryBatch[]

  @@unique([organizationId, code])
  @@index([organizationId, type, status])
  @@map("warehouses")
}

model DarkStore {
  id                    String   @id @db.Uuid
  supplyingWarehouseId  String?  @map("supplying_warehouse_id") @db.Uuid
  serviceRadiusKm       Decimal  @default(3) @map("service_radius_km") @db.Decimal(6, 2)
  servicePostalCodes    String[] @default([]) @map("service_postal_codes")
  maxOrdersPerHour      Int      @default(120) @map("max_orders_per_hour")
  maxConcurrentOrders   Int      @default(40) @map("max_concurrent_orders")
  acceptingOrders       Boolean  @default(true) @map("accepting_orders")
  lastSyncAt            DateTime? @map("last_sync_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("dark_stores")
}

// ============================================================================
// WAREHOUSE LAYOUT
// ============================================================================

enum LocationLevel {
  ZONE
  AISLE
  RACK
  SHELF
  BIN
}

enum LocationState {
  AVAILABLE
  RESERVED
  RESTRICTED
  BLOCKED
}

/// Hierarchical layout (zone > aisle > rack > shelf > bin) in one self-referencing
/// table so barcodes, capacity and occupancy are handled uniformly at every level.
model StorageLocation {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  warehouseId     String        @map("warehouse_id") @db.Uuid
  parentId        String?       @map("parent_id") @db.Uuid
  level           LocationLevel
  code            String
  fullCode        String        @map("full_code")
  barcode         String        @unique
  state           LocationState @default(AVAILABLE)
  temperatureZone String        @default("AMBIENT") @map("temperature_zone")
  capacityUnits   Int?          @map("capacity_units")
  occupiedUnits   Int           @default(0) @map("occupied_units")
  pickSequence    Int           @default(0) @map("pick_sequence")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  parent    StorageLocation?  @relation("LocationTree", fields: [parentId], references: [id])
  children  StorageLocation[] @relation("LocationTree")
  skuAssignments SkuLocation[]

  @@unique([warehouseId, fullCode])
  @@index([warehouseId, level])
  @@map("storage_locations")
}

model SkuLocation {
  id          String   @id @default(uuid()) @db.Uuid
  skuId       String   @map("sku_id") @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  isPrimary   Boolean  @default(true) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sku      Sku             @relation(fields: [skuId], references: [id])
  location StorageLocation @relation(fields: [locationId], references: [id])

  @@unique([skuId, locationId])
  @@index([warehouseId, skuId])
  @@map("sku_locations")
}

// ============================================================================
// PRODUCT CATALOG
// ============================================================================

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  products Product[]

  @@unique([organizationId, name])
  @@map("brands")
}

model ProductCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  slug           String
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]         @relation("ProductCategory")
  subProducts Product[]      @relation("ProductSubcategory")

  @@unique([organizationId, slug])
  @@map("product_categories")
}

model TaxCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  ratePercent    Decimal  @map("rate_percent") @db.Decimal(5, 2)
  hsnCode        String?  @map("hsn_code")

  products Product[]

  @@unique([organizationId, code])
  @@map("tax_categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum StorageCondition {
  AMBIENT
  CHILLED
  FROZEN
}

model Product {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  name              String
  description       String?
  brandId           String?          @map("brand_id") @db.Uuid
  categoryId        String           @map("category_id") @db.Uuid
  subcategoryId     String?          @map("subcategory_id") @db.Uuid
  taxCategoryId     String?          @map("tax_category_id") @db.Uuid
  storageCondition  StorageCondition @default(AMBIENT) @map("storage_condition")
  shelfLifeDays     Int?             @map("shelf_life_days")
  batchTracked      Boolean          @default(true) @map("batch_tracked")
  expiryTracked     Boolean          @default(true) @map("expiry_tracked")
  status            ProductStatus    @default(ACTIVE)
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)

  brand       Brand?           @relation(fields: [brandId], references: [id])
  category    ProductCategory  @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategory ProductCategory? @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  taxCategory TaxCategory?     @relation(fields: [taxCategoryId], references: [id])
  skus        Sku[]
  images      ProductImage[]

  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@map("products")
}

enum UnitOfMeasure {
  EACH
  GRAM
  KILOGRAM
  MILLILITRE
  LITRE
  PACK
}

/// A sellable variant of a product. Inventory, prices and barcodes hang off the SKU.
model Sku {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  code           String
  variantName    String?       @map("variant_name")
  unit           UnitOfMeasure @default(EACH)
  netQuantity    Decimal       @default(1) @map("net_quantity") @db.Decimal(12, 3)
  weightGrams    Int?          @map("weight_grams")
  lengthMm       Int?          @map("length_mm")
  widthMm        Int?          @map("width_mm")
  heightMm       Int?          @map("height_mm")
  mrp            Decimal       @db.Decimal(14, 2)
  sellingPrice   Decimal       @map("selling_price") @db.Decimal(14, 2)
  purchasePrice  Decimal       @map("purchase_price") @db.Decimal(14, 2)
  reorderPoint   Int           @default(10) @map("reorder_point")
  reorderQty     Int           @default(50) @map("reorder_qty")
  status         ProductStatus @default(ACTIVE)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product            @relation(fields: [productId], references: [id])
  barcodes  ProductBarcode[]
  balances  InventoryBalance[]
  batches   InventoryBatch[]
  locations SkuLocation[]

  @@unique([organizationId, code])
  @@index([productId])
  @@map("skus")
}

model ProductBarcode {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  skuId          String   @map("sku_id") @db.Uuid
  barcode        String
  symbology      String   @default("EAN13")
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([organizationId, barcode])
  @@map("product_barcodes")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  objectKey String   @map("object_key")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ============================================================================
// INVENTORY (ledger based)
// ============================================================================

enum BatchStatus {
  ACTIVE
  QUARANTINED
  EXPIRED
  RECALLED
  DEPLETED
}

model InventoryBatch {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  warehouseId     String      @map("warehouse_id") @db.Uuid
  skuId           String      @map("sku_id") @db.Uuid
  batchNumber     String      @map("batch_number")
  manufacturedAt  DateTime?   @map("manufactured_at") @db.Date
  expiresAt       DateTime?   @map("expires_at") @db.Date
  receivedAt      DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)
  unitCost        Decimal     @default(0) @map("unit_cost") @db.Decimal(14, 2)
  status          BatchStatus @default(ACTIVE)
  goodsReceiptItemId String?  @map("goods_receipt_item_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  sku       Sku                @relation(fields: [skuId], references: [id])
  balance   InventoryBalance?

  @@unique([warehouseId, skuId, batchNumber])
  @@index([warehouseId, skuId, expiresAt])
  @@map("inventory_batches")
}

/// One row per (warehouse, sku, batch). Buckets are stored explicitly; the DB
/// enforces on_hand = available + reserved and non-negative buckets (migration 0002).
/// on_hand: sellable physical stock (includes reserved).
/// damaged / quarantined / expired are physically present but NOT in on_hand.
/// in_transit: inbound stock dispatched from another site, not yet received.
model InventoryBalance {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  skuId          String   @map("sku_id") @db.Uuid
  batchId        String   @unique @map("batch_id") @db.Uuid
  onHand         Int      @default(0) @map("on_hand")
  available      Int      @default(0)
  reserved       Int      @default(0)
  damaged        Int      @default(0)
  quarantined    Int      @default(0)
  expired        Int      @default(0)
  inTransit      Int      @default(0) @map("in_transit")
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  sku       Sku            @relation(fields: [skuId], references: [id])
  batch     InventoryBatch @relation(fields: [batchId], references: [id])

  @@index([organizationId, warehouseId, skuId])
  @@index([warehouseId, skuId, available])
  @@map("inventory_balances")
}

enum InventoryBucket {
  NONE
  AVAILABLE
  RESERVED
  DAMAGED
  QUARANTINED
  EXPIRED
  IN_TRANSIT
}

enum MovementType {
  RECEIPT
  PUTAWAY
  RESERVE
  RELEASE
  PICK
  DISPATCH
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  QUARANTINE
  QUARANTINE_RELEASE
  EXPIRE
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_IN
  COUNT_CORRECTION
  WRITE_OFF
}

/// Append-only ledger. Every balance change writes exactly one movement row.
model InventoryMovement {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  warehouseId     String          @map("warehouse_id") @db.Uuid
  skuId           String          @map("sku_id") @db.Uuid
  batchId         String          @map("batch_id") @db.Uuid
  movementType    MovementType    @map("movement_type")
  fromBucket      InventoryBucket @map("from_bucket")
  toBucket        InventoryBucket @map("to_bucket")
  sourceLocation  String?         @map("source_location")
  destLocation    String?         @map("destination_location")
  quantity        Int
  referenceType   String          @map("reference_type")
  referenceId     String          @map("reference_id")
  actorType       String          @default("USER") @map("actor_type")
  actorId         String?         @map("actor_id") @db.Uuid
  reason          String?
  idempotencyKey  String          @unique @map("idempotency_key")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, warehouseId, skuId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model InventoryReservation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  warehouseId    String            @map("warehouse_id") @db.Uuid
  orderId        String?           @map("order_id") @db.Uuid
  status         ReservationStatus @default(ACTIVE)
  idempotencyKey String            @unique @map("idempotency_key")
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime?         @map("consumed_at") @db.Timestamptz(3)
  releasedAt     DateTime?         @map("released_at") @db.Timestamptz(3)
  releaseReason  String?           @map("release_reason")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  lines InventoryReservationLine[]

  @@index([status, expiresAt])
  @@index([orderId])
  @@map("inventory_reservations")
}

model InventoryReservationLine {
  id            String @id @default(uuid()) @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  skuId         String @map("sku_id") @db.Uuid
  batchId       String @map("batch_id") @db.Uuid
  quantity      Int

  reservation InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("inventory_reservation_lines")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model InventoryAdjustment {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  warehouseId    String         @map("warehouse_id") @db.Uuid
  skuId          String         @map("sku_id") @db.Uuid
  batchId        String         @map("batch_id") @db.Uuid
  bucket         InventoryBucket
  quantityDelta  Int            @map("quantity_delta")
  reasonCode     String         @map("reason_code")
  notes          String?
  status         ApprovalStatus @default(PENDING)
  requestedById  String         @map("requested_by_id") @db.Uuid
  approvedById   String?        @map("approved_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt      DateTime?      @map("decided_at") @db.Timestamptz(3)

  @@index([organizationId, status])
  @@map("inventory_adjustments")
}

enum CountStatus {
  OPEN
  SUBMITTED
  RECONCILED
  CANCELLED
}

model InventoryCount {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  warehouseId    String      @map("warehouse_id") @db.Uuid
  status         CountStatus @default(OPEN)
  blind          Boolean     @default(true)
  createdById    String      @map("created_by_id") @db.Uuid
  reconciledById String?     @map("reconciled_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  reconciledAt   DateTime?   @map("reconciled_at") @db.Timestamptz(3)

  items InventoryCountItem[]

  @@index([warehouseId, status])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id              String @id @default(uuid()) @db.Uuid
  countId         String @map("count_id") @db.Uuid
  skuId           String @map("sku_id") @db.Uuid
  batchId         String @map("batch_id") @db.Uuid
  systemQuantity  Int    @map("system_quantity")
  countedQuantity Int?   @map("counted_quantity")

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, batchId])
  @@map("inventory_count_items")
}

enum TransferStatus {
  DRAFT
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  transferNumber   String         @unique @map("transfer_number")
  fromWarehouseId  String         @map("from_warehouse_id") @db.Uuid
  toWarehouseId    String         @map("to_warehouse_id") @db.Uuid
  status           TransferStatus @default(DRAFT)
  reason           String?
  createdById      String         @map("created_by_id") @db.Uuid
  dispatchedAt     DateTime?      @map("dispatched_at") @db.Timestamptz(3)
  receivedAt       DateTime?      @map("received_at") @db.Timestamptz(3)
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  items StockTransferItem[]

  @@index([organizationId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                String  @id @default(uuid()) @db.Uuid
  transferId        String  @map("transfer_id") @db.Uuid
  skuId             String  @map("sku_id") @db.Uuid
  quantity          Int
  dispatchedQty     Int     @default(0) @map("dispatched_qty")
  receivedQty       Int     @default(0) @map("received_qty")
  allocations       Json?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

// ============================================================================
// PROCUREMENT
// ============================================================================

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  gstin          String?
  contactName    String?  @map("contact_name")
  email          String?
  phone          String?
  address        String?
  paymentTermsDays Int    @default(30) @map("payment_terms_days")
  leadTimeDays   Int      @default(2) @map("lead_time_days")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, code])
  @@map("suppliers")
}

model SupplierProduct {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  skuId       String   @map("sku_id") @db.Uuid
  supplierSku String?  @map("supplier_sku")
  unitCost    Decimal  @map("unit_cost") @db.Decimal(14, 2)
  minOrderQty Int      @default(1) @map("min_order_qty")
  validFrom   DateTime @default(now()) @map("valid_from") @db.Timestamptz(3)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, skuId, validFrom])
  @@map("supplier_products")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  poNumber       String              @unique @map("po_number")
  supplierId     String              @map("supplier_id") @db.Uuid
  warehouseId    String              @map("warehouse_id") @db.Uuid
  status         PurchaseOrderStatus @default(DRAFT)
  expectedAt     DateTime?           @map("expected_at") @db.Timestamptz(3)
  subtotal       Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal             @default(0) @map("tax_total") @db.Decimal(14, 2)
  total          Decimal             @default(0) @db.Decimal(14, 2)
  createdById    String              @map("created_by_id") @db.Uuid
  approvedById   String?             @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?           @map("approved_at") @db.Timestamptz(3)
  notes          String?
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  skuId           String  @map("sku_id") @db.Uuid
  orderedQty      Int     @map("ordered_qty")
  receivedQty     Int     @default(0) @map("received_qty")
  acceptedQty     Int     @default(0) @map("accepted_qty")
  rejectedQty     Int     @default(0) @map("rejected_qty")
  unitCost        Decimal @map("unit_cost") @db.Decimal(14, 2)
  taxRatePercent  Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, skuId])
  @@map("purchase_order_items")
}

enum GoodsReceiptStatus {
  RECEIVING
  INSPECTING
  COMPLETED
  CANCELLED
}

model GoodsReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  grnNumber       String             @unique @map("grn_number")
  purchaseOrderId String             @map("purchase_order_id") @db.Uuid
  warehouseId     String             @map("warehouse_id") @db.Uuid
  status          GoodsReceiptStatus @default(RECEIVING)
  supplierInvoiceNo String?          @map("supplier_invoice_no")
  receivedById    String             @map("received_by_id") @db.Uuid
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String    @id @default(uuid()) @db.Uuid
  goodsReceiptId String    @map("goods_receipt_id") @db.Uuid
  skuId          String    @map("sku_id") @db.Uuid
  batchNumber    String    @map("batch_number")
  manufacturedAt DateTime? @map("manufactured_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  receivedQty    Int       @map("received_qty")
  acceptedQty    Int?      @map("accepted_qty")
  rejectedQty    Int?      @map("rejected_qty")
  damagedQty     Int?      @map("damaged_qty")
  rejectionReason String?  @map("rejection_reason")
  unitCost       Decimal   @map("unit_cost") @db.Decimal(14, 2)
  inspectedById  String?   @map("inspected_by_id") @db.Uuid
  inspectedAt    DateTime? @map("inspected_at") @db.Timestamptz(3)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

// ============================================================================
// CUSTOMERS & COMMERCE
// ============================================================================

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  fullName       String    @map("full_name")
  email          String?
  phone          String
  passwordHash   String    @map("password_hash")
  status         String    @default("ACTIVE")
  failedLoginCount Int     @default(0) @map("failed_login_count")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  addresses CustomerAddress[]
  orders    Order[]
  carts     Cart[]

  @@unique([organizationId, phone])
  @@unique([organizationId, email])
  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  label       String   @default("Home")
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String   @map("postal_code")
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer   @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@index([customerId, status])
  @@map("carts")
}

model CartItem {
  id       String @id @default(uuid()) @db.Uuid
  cartId   String @map("cart_id") @db.Uuid
  skuId    String @map("sku_id") @db.Uuid
  quantity Int

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, skuId])
  @@map("cart_items")
}

model Promotion {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  description    String?
  discountType   String    @map("discount_type") // PERCENT | FLAT
  discountValue  Decimal   @map("discount_value") @db.Decimal(14, 2)
  minOrderValue  Decimal   @default(0) @map("min_order_value") @db.Decimal(14, 2)
  maxDiscount    Decimal?  @map("max_discount") @db.Decimal(14, 2)
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(3)
  usageLimit     Int?      @map("usage_limit")
  usedCount      Int       @default(0) @map("used_count")
  active         Boolean   @default(true)

  @@unique([organizationId, code])
  @@map("promotions")
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  INVENTORY_RESERVED
  ACCEPTED
  PICKING
  PICKED
  PACKING
  PACKED
  READY_FOR_DISPATCH
  RIDER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_FULFILLED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  COD
}

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  orderNumber       String        @unique @map("order_number")
  customerId        String        @map("customer_id") @db.Uuid
  darkStoreId       String        @map("dark_store_id") @db.Uuid
  addressSnapshot   Json          @map("address_snapshot")
  status            OrderStatus   @default(CREATED)
  paymentMethod     PaymentMethod @map("payment_method")
  subtotal          Decimal       @db.Decimal(14, 2)
  discountTotal     Decimal       @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal          Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  deliveryFee       Decimal       @default(0) @map("delivery_fee") @db.Decimal(14, 2)
  total             Decimal       @db.Decimal(14, 2)
  promotionCode     String?       @map("promotion_code")
  idempotencyKey    String        @map("idempotency_key")
  reservationId     String?       @map("reservation_id") @db.Uuid
  cancelReason      String?       @map("cancel_reason")
  placedAt          DateTime      @default(now()) @map("placed_at") @db.Timestamptz(3)
  deliveredAt       DateTime?     @map("delivered_at") @db.Timestamptz(3)
  version           Int           @default(1)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      Customer             @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]

  @@unique([customerId, idempotencyKey])
  @@index([organizationId, darkStoreId, status])
  @@index([organizationId, placedAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  skuId        String  @map("sku_id") @db.Uuid
  skuCode      String  @map("sku_code")
  productName  String  @map("product_name")
  quantity     Int
  pickedQty    Int     @default(0) @map("picked_qty")
  unitPrice    Decimal @map("unit_price") @db.Decimal(14, 2)
  mrp          Decimal @db.Decimal(14, 2)
  taxRatePercent Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(14, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  String       @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  reason     String?
  event      String
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum PaymentStatus {
  INITIATED
  PENDING
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED
  COD_PENDING
  COD_COLLECTED
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  method            PaymentMethod
  provider          String
  providerPaymentId String?       @unique @map("provider_payment_id")
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(INITIATED)
  failureReason     String?       @map("failure_reason")
  capturedAt        DateTime?     @map("captured_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

/// Raw, verified provider callbacks. provider_event_id is unique so duplicate
/// webhooks are stored once and processed exactly once.
model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String?  @map("payment_id") @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  eventType       String   @map("event_type")
  payload         Json
  signatureValid  Boolean  @map("signature_valid")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

model Refund {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  amount     Decimal  @db.Decimal(14, 2)
  status     String   @default("PENDING")
  reason     String?
  providerRefundId String? @map("provider_refund_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

// ============================================================================
// FULFILLMENT
// ============================================================================

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model PickingTask {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  warehouseId    String     @map("warehouse_id") @db.Uuid
  orderId        String     @map("order_id") @db.Uuid
  taskNumber     String     @unique @map("task_number")
  status         TaskStatus @default(PENDING)
  mode           String     @default("SINGLE_ORDER")
  assignedToId   String?    @map("assigned_to_id") @db.Uuid
  startedAt      DateTime?  @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  items PickingItem[]

  @@index([warehouseId, status])
  @@index([orderId])
  @@map("picking_tasks")
}

model PickingItem {
  id            String    @id @default(uuid()) @db.Uuid
  pickingTaskId String    @map("picking_task_id") @db.Uuid
  orderItemId   String    @map("order_item_id") @db.Uuid
  skuId         String    @map("sku_id") @db.Uuid
  batchId       String    @map("batch_id") @db.Uuid
  locationCode  String?   @map("location_code")
  pickSequence  Int       @default(0) @map("pick_sequence")
  quantity      Int
  pickedQty     Int       @default(0) @map("picked_qty")
  verified      Boolean   @default(false)
  scannedBarcode String?  @map("scanned_barcode")
  pickedAt      DateTime? @map("picked_at") @db.Timestamptz(3)

  task PickingTask @relation(fields: [pickingTaskId], references: [id], onDelete: Cascade)

  @@map("picking_items")
}

model PackingTask {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  warehouseId    String     @map("warehouse_id") @db.Uuid
  orderId        String     @unique @map("order_id") @db.Uuid
  status         TaskStatus @default(PENDING)
  packagingType  String?    @map("packaging_type")
  labelCode      String?    @unique @map("label_code")
  packedById     String?    @map("packed_by_id") @db.Uuid
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([warehouseId, status])
  @@map("packing_tasks")
}

// ============================================================================
// DELIVERY
// ============================================================================

model DeliveryPartner {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  homeStoreId    String   @map("home_store_id") @db.Uuid
  fullName       String   @map("full_name")
  phone          String
  vehicleType    String   @map("vehicle_type")
  vehicleNumber  String?  @map("vehicle_number")
  status         String   @default("OFFLINE") // OFFLINE | AVAILABLE | ON_DELIVERY | SUSPENDED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User?                @relation(fields: [userId], references: [id])
  assignments DeliveryAssignment[]
  shifts      RiderShift[]

  @@unique([organizationId, phone])
  @@index([homeStoreId, status])
  @@map("delivery_partners")
}

model RiderShift {
  id        String    @id @default(uuid()) @db.Uuid
  riderId   String    @map("rider_id") @db.Uuid
  startsAt  DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime  @map("ends_at") @db.Timestamptz(3)
  checkedInAt  DateTime? @map("checked_in_at") @db.Timestamptz(3)
  checkedOutAt DateTime? @map("checked_out_at") @db.Timestamptz(3)

  rider DeliveryPartner @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@map("rider_shifts")
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

model DeliveryAssignment {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  riderId        String         @map("rider_id") @db.Uuid
  darkStoreId    String         @map("dark_store_id") @db.Uuid
  status         DeliveryStatus @default(ASSIGNED)
  assignedAt     DateTime       @default(now()) @map("assigned_at") @db.Timestamptz(3)
  pickedUpAt     DateTime?      @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  failureReason  String?        @map("failure_reason")
  version        Int            @default(1)

  rider  DeliveryPartner  @relation(fields: [riderId], references: [id])
  events DeliveryEvent[]
  proof  ProofOfDelivery?

  @@index([orderId])
  @@index([riderId, status])
  @@map("delivery_assignments")
}

/// Events are only recorded from real actor input (rider app / dispatcher).
/// Latitude/longitude are null unless the device actually reported a fix.
model DeliveryEvent {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  status       DeliveryStatus
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  note         String?
  actorId      String?  @map("actor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  assignment DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
  @@map("delivery_events")
}

model ProofOfDelivery {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @unique @map("assignment_id") @db.Uuid
  method       String   // OTP | PHOTO | SIGNATURE
  otpVerified  Boolean  @default(false) @map("otp_verified")
  photoKey     String?  @map("photo_key")
  receiverName String?  @map("receiver_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  assignment DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("proof_of_delivery")
}

// ============================================================================
// INTELLIGENCE
// ============================================================================

model DemandForecast {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  skuId          String   @map("sku_id") @db.Uuid
  horizonDays    Int      @map("horizon_days")
  predictedUnits Decimal  @map("predicted_units") @db.Decimal(14, 2)
  lowerBound     Decimal  @map("lower_bound") @db.Decimal(14, 2)
  upperBound     Decimal  @map("upper_bound") @db.Decimal(14, 2)
  confidence     Decimal  @db.Decimal(5, 4)
  method         String   // e.g. "gradient_boosting" or "rule:moving_average"
  modelVersion   String   @map("model_version")
  dataFrom       DateTime @map("data_from") @db.Timestamptz(3)
  dataTo         DateTime @map("data_to") @db.Timestamptz(3)
  features       Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([warehouseId, skuId, createdAt])
  @@map("demand_forecasts")
}

model ReplenishmentRecommendation {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  warehouseId        String   @map("warehouse_id") @db.Uuid
  sourceWarehouseId  String?  @map("source_warehouse_id") @db.Uuid
  skuId              String   @map("sku_id") @db.Uuid
  currentAvailable   Int      @map("current_available")
  recommendedQty     Int      @map("recommended_qty")
  basis              String   // RULE_REORDER_POINT | FORECAST
  explanation        Json
  status             String   @default("OPEN") // OPEN | ACCEPTED | DISMISSED
  transferId         String?  @map("transfer_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([warehouseId, status])
  @@map("replenishment_recommendations")
}

// ============================================================================
// OPERATIONS: notifications, offline sync, idempotency
// ============================================================================

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  warehouseId    String?   @map("warehouse_id") @db.Uuid
  recipientType  String    @map("recipient_type") // USER | ROLE | CUSTOMER
  recipientId    String?   @map("recipient_id")
  category       String
  title          String
  body           String
  dedupeKey      String?   @unique @map("dedupe_key")
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, category, createdAt])
  @@map("notifications")
}

model EdgeDevice {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  warehouseId    String    @map("warehouse_id") @db.Uuid
  name           String
  tokenHash      String    @unique @map("token_hash")
  allowedOps     String[]  @map("allowed_ops")
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  lastSequence   BigInt    @default(0) @map("last_sequence")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("edge_devices")
}

model SyncOperation {
  id            String    @id @default(uuid()) @db.Uuid
  deviceId      String    @map("device_id") @db.Uuid
  warehouseId   String    @map("warehouse_id") @db.Uuid
  clientOpId    String    @unique @map("client_op_id")
  sequence      BigInt
  opType        String    @map("op_type")
  payload       Json
  status        String    // APPLIED | CONFLICT | REJECTED
  resultMessage String?   @map("result_message")
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(3)
  receivedAt    DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([deviceId, sequence])
  @@map("sync_operations")
}

model SyncConflict {
  id            String    @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  warehouseId   String    @map("warehouse_id") @db.Uuid
  syncOperationId String  @map("sync_operation_id") @db.Uuid
  conflictType  String    @map("conflict_type")
  details       Json
  status        String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolvedById  String?   @map("resolved_by_id") @db.Uuid
  resolution    String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@index([warehouseId, status])
  @@map("sync_conflicts")
}

/// Generic HTTP idempotency store for POST endpoints that accept Idempotency-Key.
model IdempotencyRecord {
  key          String   @id
  scope        String
  requestHash  String   @map("request_hash")
  responseCode Int      @map("response_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("idempotency_records")
}

// ============================================================================
// GOVERNANCE
// ============================================================================

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  outcome        String   // SUCCESS | DENIED | FAILED
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type")
  severity   String
  userId     String?  @map("user_id") @db.Uuid
  details    Json
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([eventType, createdAt])
  @@map("security_events")
}

model SystemSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  value          Json
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, key])
  @@map("system_settings")
}

model BackupHistory {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String
  location    String
  sizeBytes   BigInt?  @map("size_bytes")
  checksum    String?
  status      String
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  @@map("backup_history")
}

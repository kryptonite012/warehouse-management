{
  "title": "QuickStore API",
  "uid": "quickstore-api",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "type": "timeseries", "title": "Requests / s by status", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status) (rate(quickstore_http_request_duration_seconds_count[1m]))" }] },
    { "type": "timeseries", "title": "Latency p50 / p95 / p99 (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(quickstore_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(quickstore_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(quickstore_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ] },
    { "type": "timeseries", "title": "Business events / min", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (event) (rate(quickstore_business_events_total[5m])) * 60" }] },
    { "type": "timeseries", "title": "Slowest routes p95 (s)", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "topk(5, histogram_quantile(0.95, sum(rate(quickstore_http_request_duration_seconds_bucket[5m])) by (le, route)))", "legendFormat": "{{route}}" }] },
    { "type": "timeseries", "title": "Node.js event loop lag (s)", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "quickstore_nodejs_eventloop_lag_p99_seconds" }] },
    { "type": "timeseries", "title": "PostgreSQL active connections", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(pg_stat_activity_count{state=\"active\"})" }] }
  ]
}

# Rendered by the nginx image's envsubst step: ADMIN_HOST, SHOP_HOST.

server {
  listen 80 default_server;
  server_name _;
  location = /healthz { access_log off; return 200 "ok\n"; }
  location / { return 301 https://$host$request_uri; }
}

# Admin console + mobile staff apps
server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_HOST};
  ssl_certificate /etc/nginx/certs/server.crt;
  ssl_certificate_key /etc/nginx/certs/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:TLS:10m;
  include /etc/nginx/snippets/security-headers.conf;

  root /usr/share/nginx/admin;
  include /etc/nginx/snippets/api-proxy.conf;
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; include /etc/nginx/snippets/security-headers.conf; }
  location / { try_files $uri /index.html; }
}

# Customer storefront
server {
  listen 443 ssl;
  http2 on;
  server_name ${SHOP_HOST};
  ssl_certificate /etc/nginx/certs/server.crt;
  ssl_certificate_key /etc/nginx/certs/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  include /etc/nginx/snippets/security-headers.conf;

  root /usr/share/nginx/shop;
  include /etc/nginx/snippets/api-proxy.conf;
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; include /etc/nginx/snippets/security-headers.conf; }
  location / { try_files $uri /index.html; }
}

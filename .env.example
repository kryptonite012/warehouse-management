# ---------- Core ----------
NODE_ENV=development
API_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ---------- Database ----------
POSTGRES_USER=quickstore
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=quickstore
DATABASE_URL=postgresql://quickstore:change-me-postgres@localhost:5432/quickstore?schema=public

# ---------- Cache / Broker ----------
REDIS_URL=redis://localhost:6379
RABBITMQ_DEFAULT_USER=quickstore
RABBITMQ_DEFAULT_PASS=change-me-rabbit
RABBITMQ_URL=amqp://quickstore:change-me-rabbit@localhost:5672

# ---------- Auth ----------
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------- Inventory ----------
RESERVATION_TTL_MINUTES=15

# ---------- Payments ----------
# Leave empty to keep online payments in "not configured" state.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
COD_ENABLED=true

# ---------- Object storage ----------
MINIO_ROOT_USER=quickstore
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_ENDPOINT=http://localhost:9000

# ---------- AI engine (optional) ----------
AI_ENGINE_URL=http://localhost:8000

# ---------- Edge agent ----------
EDGE_CENTRAL_URL=http://localhost:3000/api/v1
EDGE_DEVICE_TOKEN=

# ---------- Monitoring ----------
GRAFANA_ADMIN_PASSWORD=change-me-grafana
